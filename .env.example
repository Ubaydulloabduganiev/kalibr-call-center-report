APP_ENV=production
APP_NAME=Kalibr amoCRM Report Bot
APP_VERSION=1.0.0
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=redis://HOST:6379/0

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KalibrCallCenterBot
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-api.onrender.com

KOMMO_SUBDOMAIN=your-subdomain
KOMMO_LONG_LIVED_TOKEN=
KOMMO_REQUESTS_PER_SECOND=6
KOMMO_USER_CACHE_SECONDS=300
KOMMO_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
INITIAL_IMPORT_DAYS=365

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-another-long-random-secret
LINK_TOKEN_MINUTES=30
PHONE_HASH_SALT=replace-with-a-random-secret

SYNC_LOOKBACK_MINUTES=15
DAILY_OPERATOR_TIME=18:30
DAILY_MANAGER_TIME=19:00
DAILY_EXECUTIVE_TIME=20:00
WEEKLY_REPORT_WEEKDAY=0
WEEKLY_REPORT_TIME=09:00
MONTHLY_REPORT_TIME=09:30
DEFAULT_LANGUAGE=ru
